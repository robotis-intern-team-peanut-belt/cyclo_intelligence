# Copy to docker/.env and fill in. docker/.env is git-ignored — never commit a key.
#
#   cp docker/.env.example docker/.env
#
# docker/container.sh sources this before launching a training container, and
# docker-compose.yml passes these through to the lerobot_train service.

# Weights & Biases. Get yours at https://wandb.ai/authorize
# Leave unset to train with local logs only (tracking.backend: none).
# WANDB_API_KEY=

# Force wandb offline on an air-gapped box; sync later with `wandb sync`.
# WANDB_MODE=offline

# Pin training to a specific GPU on a multi-GPU host.
# IMPORTANT: leave this UNSET (not empty) to use all GPUs — an empty value hides
# every GPU from torch rather than meaning "all".
# CUDA_VISIBLE_DEVICES=0
